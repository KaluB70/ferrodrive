{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferrodrive",
  "mainBinaryName": "ferrodrive",
  "identifier": "io.github.kalub70.ferrodrive",
  "build": {
    "frontendDist": "../../ui/dist/ui/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm --prefix ../../ui start",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ferrodrive",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
